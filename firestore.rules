rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Administrators are listed by uid in the admins collection, written only
    // from the Firebase console — never from the app.
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // A user profile document is private to its owner.
    match /users/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isAdmin();
      allow update, delete: if isAdmin();

      allow create: if signedIn()
                    && request.auth.uid == uid
                    && request.resource.data.uid == uid
                    && !("disabled" in request.resource.data);

      // Owners may edit their profile but never lift a suspension themselves.
      allow update: if signedIn()
                    && request.auth.uid == uid
                    && request.resource.data.uid == resource.data.uid
                    && request.resource.data.get("disabled", false) == resource.data.get("disabled", false);
    }

    // Fantasy squads: readable by any signed-in user (league tables), writable by the owner.
    match /fantasyTeams/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn()
                            && request.auth.uid == uid
                            && request.resource.data.uid == uid;
      allow delete: if isAdmin();
    }

    // Master data imported from the clubs/players export.
    // Everyone signed in reads it; only administrators may write it.
    match /teams/{teamId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /players/{playerId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /playerTransfers/{transferId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /dataImports/{importId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // Football statistics stored from the data provider.
    match /matches/{matchId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /matchEvents/{eventId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /playerMatchStats/{statId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /gameweeks/{gameweekId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /playerPoints/{entryId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Mini-leagues: members read; anyone signed in may look up by invite code to join.
    match /leagues/{leagueId} {
      allow read: if signedIn();
      allow create: if signedIn()
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.memberUids == [request.auth.uid];
      // Members may only add or remove themselves; league metadata stays fixed.
      allow update: if signedIn()
                    && request.resource.data.name == resource.data.name
                    && request.resource.data.code == resource.data.code
                    && request.resource.data.ownerUid == resource.data.ownerUid
                    && request.resource.data.memberUids.hasOnly(resource.data.memberUids.concat([request.auth.uid]))
                    && resource.data.memberUids.hasOnly(request.resource.data.memberUids.concat([request.auth.uid]));
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    match /transfers/{transferId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // Editorial content and fantasy settings managed by administrators.
    match /news/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /videos/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /settings/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
